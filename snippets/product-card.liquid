<article class="product-card">
  <a href="{{ product.url }}" class="product-card-media" aria-label="Ver {{ product.title | escape }}">
    {% if product.featured_media != blank %}
      {{ product.featured_media.preview_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '220,360,540,720,900', sizes: '(min-width: 1000px) 25vw, (min-width: 680px) 33vw, 50vw', alt: product.title }}
    {% else %}<span class="product-no-image">Imagem indisponível</span>{% endif %}
    {% unless product.available %}<span class="product-badge">Esgotado</span>{% else %}{% if product.compare_at_price > product.price %}<span class="product-badge">Oferta</span>{% endif %}{% endunless %}
  </a>
  <div class="product-card-info">
    {% if product.vendor != blank %}<span class="eyebrow product-vendor">{{ product.vendor | escape }}</span>{% endif %}
    <h3><a href="{{ product.url }}">{{ product.title | escape }}</a></h3>
    {% render 'price', product: product %}
  </div>
</article>
