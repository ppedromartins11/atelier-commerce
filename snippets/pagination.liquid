{% if paginate.pages > 1 %}
<nav class="pagination" aria-label="Páginas">
  {% if paginate.previous %}<a href="{{ paginate.previous.url }}" aria-label="Página anterior">← Anterior</a>{% endif %}
  {% for part in paginate.parts %}
    {% if part.is_link %}<a href="{{ part.url }}" aria-label="Página {{ part.title }}">{{ part.title }}</a>{% elsif part.title == paginate.current_page %}<span aria-current="page">{{ part.title }}</span>{% else %}<span>{{ part.title }}</span>{% endif %}
  {% endfor %}
  {% if paginate.next %}<a href="{{ paginate.next.url }}" aria-label="Próxima página">Próxima →</a>{% endif %}
</nav>
{% endif %}
