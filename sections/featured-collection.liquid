<section class="section-spacing featured-collection"><div class="container">
  <div class="section-heading"><div><span class="eyebrow">{{ section.settings.kicker | escape }}</span><h2>{{ section.settings.heading | escape }}</h2></div>
    {% if section.settings.collection != blank %}<a class="text-link" href="{{ section.settings.collection.url }}">Ver coleção {% render 'icon', name: 'arrow' %}</a>{% endif %}</div>
  {% if section.settings.collection != blank and section.settings.collection.products_count > 0 %}
    <div class="product-grid">{% for product in section.settings.collection.products limit: section.settings.limit %}{% render 'product-card', product: product %}{% endfor %}</div>
  {% elsif request.design_mode %}<div class="empty-state">Selecione uma coleção com produtos no editor do tema para preencher esta seção.</div>
  {% else %}<div class="empty-state">Em breve, novidades por aqui.</div>{% endif %}
</div></section>
{% schema %}
{"name":"Coleção de produtos","settings":[{"type":"text","id":"kicker","label":"Etiqueta","default":"Seleção especial"},{"type":"text","id":"heading","label":"Título","default":"Em destaque"},{"type":"collection","id":"collection","label":"Coleção"},{"type":"range","id":"limit","label":"Quantidade de produtos","min":4,"max":12,"step":1,"default":8}],"presets":[{"name":"Coleção de produtos"}]}
{% endschema %}
