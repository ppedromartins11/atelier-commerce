<article class="section-spacing standard-page"><div class="container narrow"><nav class="breadcrumbs"><a href="{{ blog.url }}">{{ blog.title | escape }}</a><span>/</span><span aria-current="page">Artigo</span></nav><div class="page-heading"><span class="eyebrow">{{ article.published_at | date: '%d/%m/%Y' }}</span><h1>{{ article.title | escape }}</h1></div>{% if article.image %}<div class="article-image">{{ article.image | image_url: width: 1200 | image_tag: loading: 'eager', widths: '480,800,1200', alt: article.title }}</div>{% endif %}<div class="rte">{{ article.content }}</div><a class="text-link" href="{{ blog.url }}">← Voltar ao blog</a></div></article>
{% schema %}{"name":"Artigo","settings":[]}{% endschema %}
