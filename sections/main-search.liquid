<section class="section-spacing search-page"><div class="container"><div class="page-heading"><span class="eyebrow">Encontre sua próxima escolha</span><h1>Buscar produtos</h1></div>
  <form action="{{ routes.search_url }}" method="get" role="search" class="search-form"><label class="visually-hidden" for="site-search">Buscar</label><input id="site-search" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Nome, marca ou categoria" required><input type="hidden" name="type" value="product"><button type="submit" class="button">Buscar {% render 'icon', name: 'search' %}</button></form>
  {% if search.performed %}
    {% paginate search.results by section.settings.results_per_page %}
      <p class="search-summary">{{ search.results_count }} resultado(s) para <strong>{{ search.terms | escape }}</strong></p>
      {% if search.results_count > 0 %}<div class="product-grid">{% for item in search.results %}{% if item.object_type == 'product' %}{% render 'product-card', product: item %}{% endif %}{% endfor %}</div>{% else %}<div class="empty-state">Nenhum produto encontrado. Experimente outro termo.</div>{% endif %}
      {% render 'pagination', paginate: paginate %}
    {% endpaginate %}
  {% endif %}
</div></section>
{% schema %}{"name":"Busca","settings":[{"type":"range","id":"results_per_page","label":"Resultados por página","min":8,"max":40,"step":4,"default":16}]}{% endschema %}
