<section class="newsletter section-spacing"><div class="container newsletter-inner"><div><span class="eyebrow">Fique por dentro</span><h2>{{ section.settings.title | escape }}</h2><p>{{ section.settings.description | escape }}</p></div>
  {% form 'customer', class: 'newsletter-form' %}
    <input type="hidden" name="contact[tags]" value="newsletter">
    <label for="newsletter-email-{{ section.id }}" class="visually-hidden">Seu e-mail</label>
    <input id="newsletter-email-{{ section.id }}" type="email" name="contact[email]" placeholder="Seu melhor e-mail" required autocomplete="email" value="{{ form.email }}">
    <button type="submit" class="button">Quero receber {% render 'icon', name: 'arrow' %}</button>
    {% if form.posted_successfully? %}<p class="form-message" role="status">Cadastro realizado com sucesso.</p>{% endif %}
    {% if form.errors %}<div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>{% endif %}
  {% endform %}
</div></section>
{% schema %}
{"name":"Newsletter","settings":[{"type":"text","id":"title","label":"Título","default":"Novidades direto para você."},{"type":"textarea","id":"description","label":"Descrição","default":"Cadastre-se para acompanhar lançamentos e novidades da nossa loja."}],"presets":[{"name":"Newsletter"}]}
{% endschema %}
