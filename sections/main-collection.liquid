<section class="section-spacing collection-page"><div class="container">
  <div class="page-heading"><span class="eyebrow">Coleção / {{ collection.products_count }} produtos</span><h1>{{ collection.title | escape }}</h1>{% if collection.description != blank %}<div class="rte page-subtitle">{{ collection.description }}</div>{% endif %}</div>
  {% paginate collection.products by section.settings.products_per_page %}
    <div class="collection-toolbar"><span>{{ collection.products_count }} produtos</span>
      <form method="get" class="sort-form" data-auto-submit><label for="sort-{{ section.id }}">Ordenar por</label><select id="sort-{{ section.id }}" name="sort_by">
        {% assign sort_selected = collection.sort_by | default: collection.default_sort_by %}
        {% for option in collection.sort_options %}<option value="{{ option.value | escape }}" {% if option.value == sort_selected %}selected{% endif %}>{{ option.name | escape }}</option>{% endfor %}
      </select>
      {% for active_filter in collection.filters %}
        {% for value in active_filter.active_values %}<input type="hidden" name="{{ value.param_name | escape }}" value="{{ value.value | escape }}">{% endfor %}
        {% if active_filter.type == 'price_range' %}
          {% if active_filter.min_value.value %}<input type="hidden" name="{{ active_filter.min_value.param_name | escape }}" value="{{ active_filter.min_value.value | divided_by: 100.0 }}">{% endif %}
          {% if active_filter.max_value.value %}<input type="hidden" name="{{ active_filter.max_value.param_name | escape }}" value="{{ active_filter.max_value.value | divided_by: 100.0 }}">{% endif %}
        {% endif %}
      {% endfor %}</form>
    </div>
    {% if collection.filters.size > 0 %}<form method="get" class="filter-bar" data-auto-submit><input type="hidden" name="sort_by" value="{{ sort_selected | escape }}">
      {% for filter in collection.filters %}<details class="filter-dropdown"><summary>{{ filter.label | escape }}{% if filter.active_values.size > 0 %} ({{ filter.active_values.size }}){% endif %}</summary>

          {% case filter.type %}
          {% when 'list' or 'boolean' %}
            {% for value in filter.values %}<label class="filter-option"><input type="checkbox" name="{{ value.param_name | escape }}" value="{{ value.value | escape }}" {% if value.active %}checked{% endif %} {% if value.count == 0 and value.active == false %}disabled{% endif %}>{{ value.label | escape }} <small>({{ value.count }})</small></label>{% endfor %}
          {% when 'price_range' %}<div class="price-filter"><label>De <input name="{{ filter.min_value.param_name | escape }}" type="number" min="0" value="{{ filter.min_value.value | divided_by: 100.0 }}" placeholder="0"></label><label>Até <input name="{{ filter.max_value.param_name | escape }}" type="number" min="0" value="{{ filter.max_value.value | divided_by: 100.0 }}" placeholder="{{ filter.range_max | divided_by: 100.0 }}"></label><button type="submit" class="button button--small">Aplicar</button></div>
          {% endcase %}
      </details>{% endfor %}
      {% if collection.url != blank %}<a class="text-link" href="{{ collection.url }}?sort_by={{ sort_selected | url_encode }}">Limpar filtros</a>{% endif %}
    </form>{% endif %}
    {% if collection.products.size > 0 %}<div class="product-grid">{% for product in collection.products %}{% render 'product-card', product: product %}{% endfor %}</div>{% else %}<div class="empty-state">Não encontramos produtos com esses filtros. <a href="{{ collection.url }}">Limpar filtros</a></div>{% endif %}
    {% render 'pagination', paginate: paginate %}
  {% endpaginate %}
</div></section>
{% schema %}
{"name":"Página de coleção","settings":[{"type":"range","id":"products_per_page","min":8,"max":40,"step":4,"label":"Produtos por página","default":16}]}
{% endschema %}
