{% assign configured_categories = 0 %}
{% for block in section.blocks %}
  {% if block.settings.collection != blank or block.settings.image != blank %}{% assign configured_categories = configured_categories | plus: 1 %}{% endif %}
{% endfor %}
{% if configured_categories > 0 or request.design_mode %}
<section class="section-spacing collection-highlights"><div class="container">
  <div class="section-heading"><div><span class="eyebrow">{{ section.settings.kicker | escape }}</span><h2>{{ section.settings.heading | escape }}</h2></div></div>
  <div class="category-grid">
    {% for block in section.blocks %}
      {% assign category = block.settings.collection %}
      {% if category != blank or block.settings.image != blank or request.design_mode %}
      <a class="category-tile" href="{{ category.url | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>
        {% assign photo = block.settings.image | default: category.featured_image %}
        {% if photo != blank %}{{ photo | image_url: width: 900 | image_tag: loading: 'lazy', widths: '320,540,900', sizes: '(min-width: 760px) 33vw, 100vw', alt: category.title }}{% endif %}
        <span class="category-overlay"></span>
        <span class="category-content"><span>{{ block.settings.caption | escape }}</span><strong>{{ block.settings.title | default: category.title | default: "Escolha uma categoria" | escape }}</strong><span class="category-arrow">↗</span></span>
      </a>
      {% endif %}
    {% endfor %}
  </div>
</div></section>
{% endif %}
{% schema %}
{"name":"Categorias em destaque","settings":[{"type":"text","id":"kicker","label":"Etiqueta","default":"Encontre o seu estilo"},{"type":"text","id":"heading","label":"Título","default":"Explore por categoria"}],"blocks":[{"type":"category","name":"Categoria","settings":[{"type":"collection","id":"collection","label":"Coleção"},{"type":"image_picker","id":"image","label":"Imagem"},{"type":"text","id":"title","label":"Título alternativo"},{"type":"text","id":"caption","label":"Texto pequeno","default":"Coleção"}]}],"max_blocks":6,"presets":[{"name":"Categorias em destaque","blocks":[{"type":"category"},{"type":"category"},{"type":"category"}]}]}
{% endschema %}
