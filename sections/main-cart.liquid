<section class="section-spacing cart-page"><div class="container"><div class="page-heading"><span class="eyebrow">Sua seleção</span><h1>Carrinho <span class="heading-count">({{ cart.item_count }})</span></h1></div>
  {% if cart.item_count > 0 %}<form action="{{ routes.cart_url }}" method="post" novalidate>
    <div class="cart-layout"><div class="cart-items">
      {% for item in cart.items %}<div class="cart-item">
        <a href="{{ item.url }}" class="cart-item-photo">{% if item.image %}{{ item.image | image_url: width: 320 | image_tag: loading: 'lazy', widths: '160,320', alt: item.product.title }}{% endif %}</a>
        <div class="cart-item-description"><h2><a href="{{ item.url }}">{{ item.product.title | escape }}</a></h2>{% unless item.variant.title == 'Default Title' %}<p>{{ item.variant.title | escape }}</p>{% endunless %}
          {% for property in item.properties %}{% assign key_first_char = property.first | slice: 0 %}{% if property.last != blank and key_first_char != '_' %}<p>{{ property.first | escape }}: {{ property.last | escape }}</p>{% endif %}{% endfor %}
          <a class="text-link" href="{{ item.url_to_remove }}">Remover</a>
        </div>
        <div class="cart-item-controls"><strong>{{ item.final_line_price | money }}</strong>{% if item.original_line_price > item.final_line_price %}<s>{{ item.original_line_price | money }}</s>{% endif %}<label for="cart-quantity-{{ forloop.index }}">Qtd.</label><input id="cart-quantity-{{ forloop.index }}" type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="Quantidade de {{ item.product.title | escape }}"></div>
      </div>{% endfor %}
      <button type="submit" name="update" class="button button--outline">Atualizar carrinho</button>
    </div><aside class="cart-summary"><h2>Resumo do pedido</h2><div class="cart-subtotal"><span>Subtotal</span><strong>{{ cart.total_price | money }}</strong></div>
      {% if cart.cart_level_discount_applications.size > 0 %}{% for discount in cart.cart_level_discount_applications %}<p>{{ discount.title | escape }}: -{{ discount.total_allocated_amount | money }}</p>{% endfor %}{% endif %}
      <p>Frete, descontos adicionais e impostos são calculados ou confirmados no checkout.</p>
      <button type="submit" name="checkout" class="button button--wide">Finalizar compra {% render 'icon', name: 'arrow' %}</button>
      <a href="{{ routes.all_products_collection_url }}" class="text-link">Continuar comprando</a>
    </aside></div>
  </form>
  {% else %}<div class="empty-state"><p>Seu carrinho ainda está vazio.</p><a class="button" href="{{ routes.all_products_collection_url }}">Explorar produtos {% render 'icon', name: 'arrow' %}</a></div>{% endif %}
</div></section>
{% schema %}{"name":"Carrinho","settings":[]}{% endschema %}
