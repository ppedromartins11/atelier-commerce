<header class="site-header" data-header>
  <div class="container header-inner">
    <button class="icon-button mobile-menu-button" type="button" aria-label="Abrir menu" aria-controls="mobile-nav" aria-expanded="false" data-nav-open>{% render 'icon', name: 'menu' %}</button>
    <a href="{{ routes.root_url }}" class="brand" aria-label="{{ shop.name | escape }} — Início">
      {% if section.settings.logo != blank %}{{ section.settings.logo | image_url: width: 340 | image_tag: class: 'brand-logo', loading: 'eager', widths: '120,180,240,340', alt: shop.name }}{% else %}<span>{{ shop.name | escape }}</span><span class="brand-dot">.</span>{% endif %}
    </a>
    <nav class="desktop-nav" aria-label="Navegação principal">
      {% if section.settings.menu != blank %}
        {% for link in section.settings.menu.links %}
          <div class="nav-item"><a href="{{ link.url }}" {% if link.active %}aria-current="page"{% endif %}>{{ link.title | escape }}</a>
            {% if link.links.size > 0 %}<div class="nav-submenu">{% for child in link.links %}<a href="{{ child.url }}">{{ child.title | escape }}</a>{% endfor %}</div>{% endif %}
          </div>
        {% endfor %}
      {% else %}
        <a href="{{ routes.all_products_collection_url }}">Todos os produtos</a>
        <a href="{{ routes.search_url }}">Descobrir</a>
      {% endif %}
    </nav>
    <div class="header-actions">
      <a href="{{ routes.search_url }}" class="icon-button" aria-label="Buscar produtos">{% render 'icon', name: 'search' %}</a>
      {% if shop.customer_accounts_enabled %}<a href="{{ routes.account_url }}" class="icon-button account-icon" aria-label="Minha conta">{% render 'icon', name: 'user' %}</a>{% endif %}
      <a href="{{ routes.cart_url }}" class="cart-button" aria-label="Carrinho: {{ cart.item_count }} itens">{% render 'icon', name: 'bag' %}<span class="cart-count">{{ cart.item_count }}</span></a>
    </div>
  </div>
  <div class="mobile-nav" id="mobile-nav" hidden data-mobile-nav>
    <div class="mobile-nav-top"><span>Explorar</span><button class="icon-button" type="button" data-nav-close aria-label="Fechar menu">{% render 'icon', name: 'close' %}</button></div>
    <nav aria-label="Navegação móvel">
      {% if section.settings.menu != blank %}
        {% for link in section.settings.menu.links %}
          <a href="{{ link.url }}">{{ link.title | escape }}</a>
          {% for child in link.links %}<a href="{{ child.url }}" class="mobile-nav-child">{{ child.title | escape }}</a>{% endfor %}
        {% endfor %}
      {% else %}<a href="{{ routes.all_products_collection_url }}">Todos os produtos</a><a href="{{ routes.search_url }}">Buscar</a>{% endif %}
    </nav>
  </div>
</header>
{% schema %}
{"name":"Cabeçalho","settings":[{"type":"image_picker","id":"logo","label":"Logotipo"},{"type":"link_list","id":"menu","label":"Menu principal"}]}
{% endschema %}
