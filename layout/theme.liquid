<!doctype html>
<html lang="{{ request.locale.iso_code }}" data-currency="{{ cart.currency.iso_code | escape }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="{{ settings.color_background }}">
  <link rel="canonical" href="{{ canonical_url }}">
  {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
  <title>{{ page_title | escape }}{% if current_tags %} — {{ current_tags | join: ', ' }}{% endif %}{% unless page_title contains shop.name %} — {{ shop.name | escape }}{% endunless %}</title>
  {% if settings.favicon != blank %}<link rel="icon" href="{{ settings.favicon | image_url: width: 64 }}" sizes="32x32">{% endif %}
  {{ content_for_header }}
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  <style>
    :root {
      --background: {{ settings.color_background }};
      --surface: {{ settings.color_surface }};
      --foreground: {{ settings.color_text }};
      --muted: {{ settings.color_muted }};
      --accent: {{ settings.color_accent }};
      --accent-contrast: {{ settings.color_accent_text }};
      --border: {{ settings.color_border }};
      --container: {{ settings.container_width }}px;
    }
  </style>
  <script src="{{ 'theme.js' | asset_url }}" defer></script>
</head>
<body class="template-{{ request.page_type | handle }}">
  <a href="#main-content" class="skip-link">Pular para o conteúdo</a>
  {% section 'announcement-bar' %}
  {% section 'header' %}
  <main id="main-content" tabindex="-1">{{ content_for_layout }}</main>
  {% section 'footer' %}
</body>
</html>
